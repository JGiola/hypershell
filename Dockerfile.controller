FROM registry.access.redhat.com/ubi9/go-toolset:1.25 AS builder

USER root

WORKDIR /workspace

COPY rh-trex-ai/ /rh-trex-ai/

COPY hypershell/go.mod hypershell/go.sum ./
COPY hypershell/cmd/ cmd/
COPY hypershell/pkg/ pkg/
COPY hypershell/plugins/ plugins/
COPY hypershell/openapi/ openapi/
COPY hypershell/proto/ proto/
COPY hypershell/components/control-plane/ components/control-plane/

WORKDIR /workspace/components/control-plane
RUN go build -ldflags="-s -w" -o /workspace/hypershell-controller ./cmd/hypershell-controller

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

WORKDIR /

COPY --from=builder /workspace/hypershell-controller /usr/local/bin/

ENTRYPOINT ["/usr/local/bin/hypershell-controller"]

LABEL name="hypershell-controller" \
      version="0.0.1" \
      summary="HyperShell Controller" \
      description="Control plane that reconciles HyperShell resources via gRPC watch streams"
